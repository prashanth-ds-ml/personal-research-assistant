# Search
# Left unset on purpose: an env var always beats the dashboard's per-run
# "Search" dropdown (see Configuration.from_runnable_config). Default is
# duckduckgo; set to local_docs to make internal documents the only backend.
# SEARCH_API=duckduckgo
SEARXNG_URL=

# Internal-document search (search_api=local_docs): PDF/Markdown/text folder
DOCS_PATH=./sample_docs

# Web Search API Keys (not needed for duckduckgo)
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# LLM Configuration
LLM_PROVIDER=ollama
# Default model for every role. The dashboard cannot change it; edit it here. gemma4:e4b or qwen3:8b also work.
LOCAL_LLM=llama3.1:8b
# Optional per-role models for deep research (blank = LOCAL_LLM). Bigger planner/writer, small extractor is a good mix.
PLANNER_MODEL=
EXTRACTOR_MODEL=
# gemma4:e4b writes better than llama in our benchmark (BENCHMARKS.md); planning and extraction stay on LOCAL_LLM.
WRITER_MODEL=gemma4:e4b
# ollama (default) or lmstudio
LMSTUDIO_BASE_URL=http://localhost:1234/v1
OLLAMA_BASE_URL=http://localhost:11434

# Precedence: a NON-EMPTY environment variable beats everything; an empty one (`NAME=`) counts as unset.
# Only a few per-run options may be changed from the dashboard (loops, search source, fetch toggle, seed URLs);
# paths, URLs and model names come from the environment only, so a web page cannot redirect them.
# MAX_WEB_RESEARCH_LOOPS is deliberately NOT set here: setting it would override the dashboard's "Max research loops".
FETCH_FULL_PAGE=True

# LangSmith tracing (optional - leave blank to disable)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=personal-research-assistant

# Obsidian vault (personal research assistant) - point this at your own vault
VAULT_PATH=/absolute/path/to/your/ObsidianVault
SOURCES_SUBDIR=Sources
RESEARCH_SUBDIR=Research
PROFILE_NOTE_PATH=Profile.md
ARCHIVE_FULL_SOURCES=True

# Vault-as-context retrieval
ENABLE_VAULT_CONTEXT=True
VAULT_CONTEXT_TOP_K=5
EMBEDDING_MODEL=ollama:qwen3-embedding:0.6b

# Evolving profile
ENABLE_PROFILE_UPDATE=True

# OS notification on completion (Windows only - see notifications.py)
NOTIFY_ON_COMPLETE=True

# ---- Deep research (goal-driven graph) ----
# The knowledge base (hybrid BM25 + vector index). Blank = <VAULT_PATH>/.kb/library.sqlite
KB_PATH=
# Folders kept indexed, separated by ';'. Blank = <VAULT_PATH>/Sources and <VAULT_PATH>/Library.
# NOTE: DOCS_PATH above is only used by the quick assistant's "Internal documents" search; add it here too if
# deep research should read it.
LIBRARY_FOLDERS=
AUTO_INGEST=True
DOCS_RETRIEVAL_K=8
ASK_CLARIFYING_QUESTIONS=True
REQUIRE_PLAN_APPROVAL=True
# Fetch new open-access papers (arXiv, Europe PMC) after plan approval. The dashboard has a checkbox for this.
COLLECT_SOURCES=
# Where the collector finds web pages: ddgs (DuckDuckGo, default) or searxng (set SEARXNG_URL).
SEARCH_BACKEND=ddgs
# Only collect web pages from these domains (';'-separated, * allowed). Blank = any public site.
COLLECT_ALLOW_DOMAINS=
COLLECT_BLOCK_DOMAINS=
COLLECT_CANDIDATES_PER_QUESTION=8
# Pause and show the candidates so you choose (True). False = take everything at or above FETCH_MIN_RELEVANCE.
COLLECT_REVIEW=
# 0 = no limit: you choose what to collect in the review step (set a number to cap it).
FETCH_MAX_SOURCES=0
COLLECT_MAX_CANDIDATES=0
# Where else to look besides the web search, arXiv and Europe PMC (all free, no keys):
COLLECT_HUGGINGFACE=True          # Hugging Face Papers, model cards, dataset cards
COLLECT_AI_SITES=True             # extra searches restricted to the sites below (the first 12 are used)
COLLECT_EXTRA_SITES=huggingface.co;github.com;docs.langchain.com;anthropic.com;openai.com;lilianweng.github.io;eugeneyan.com;huyenchip.com;hamel.dev;simonwillison.net;pinecone.io;ai.google.dev
COLLECT_EUROPEPMC=True            # set False for AI/software topics (it only adds unrelated medical papers)
# Keep a fetched paper only if the local model scores it >= this (0-3). 3 = directly answers the question.
FETCH_MIN_RELEVANCE=3
# Goes into the fetcher's User-Agent so site owners can reach you (optional).
CONTACT_EMAIL=

# ---- Quick assistant extras ----
DOCS_TOP_K=4
DOCS_CHUNK_SIZE=800
USE_TOOL_CALLING=False
STRIP_THINKING_TOKENS=True
ENABLE_COMPARISON_PLANNING=True
MAX_COMPARISON_ENTITIES=3
