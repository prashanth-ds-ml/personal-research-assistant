# Search
SEARCH_API='duckduckgo'
SEARXNG_URL=

# Web Search API Keys (not needed for duckduckgo)
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# LLM Configuration
LLM_PROVIDER=ollama
LOCAL_LLM=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Not set here on purpose: env vars always win over a per-run `configurable`
# override (see Configuration.from_runnable_config), so setting this would
# silently defeat the dashboard's "Max research loops" input. Falls back to
# the Configuration class default (3) when the dashboard doesn't override it.
FETCH_FULL_PAGE=True

# LangSmith tracing (optional - leave blank to disable)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=personal-research-assistant

# Obsidian vault (personal research assistant) - point this at your own vault
VAULT_PATH=/absolute/path/to/your/ObsidianVault
SOURCES_SUBDIR=Sources
RESEARCH_SUBDIR=Research
PROFILE_NOTE_PATH=Profile.md
ARCHIVE_FULL_SOURCES=True

# Vault-as-context retrieval
ENABLE_VAULT_CONTEXT=True
VAULT_CONTEXT_TOP_K=5
EMBEDDING_MODEL=ollama:qwen3-embedding:0.6b

# Evolving profile
ENABLE_PROFILE_UPDATE=True

# OS notification on completion (Windows only - see notifications.py)
NOTIFY_ON_COMPLETE=True

# Debate mode: ENABLE_DEBATE_MODE deliberately NOT set here - it's opt-in
# per run via the dashboard's "Debate mode" checkbox (config.configurable),
# and an env var here would always override that per-run choice (see note
# above). Falls back to the Configuration class default (False) otherwise.
DEBATE_CPU_MODEL=gemma3:4b
