# LangGraph dev server this dashboard talks to (via the API passthrough route)
LANGGRAPH_API_URL=http://127.0.0.1:2025
# Optional - only needed if LangSmith tracing is enabled on the backend
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-desk

# Obsidian vault (server-side only, read by src/lib/vault.ts) - same path as the backend's .env
VAULT_PATH=/absolute/path/to/your/ObsidianVault
RESEARCH_SUBDIR=Research
PROFILE_NOTE_PATH=Profile.md

# Embeddings for the knowledge graph (src/lib/embeddings.ts)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b

# Client-side (exposed to the browser)
# Must be an absolute URL - the SDK's useStream hook does `new URL(apiUrl)`
# internally and throws on a bare relative path like "/api".
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_LANGGRAPH_ASSISTANT_ID=research_assistant
NEXT_PUBLIC_LANGSMITH_PROJECT_URL=https://smith.langchain.com/
